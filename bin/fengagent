#!/bin/sh
## FengAgentCli CLI wrapper for npm bin
## Runs the CLI entry via bun (preferred) or node

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
ENTRY="$SCRIPT_DIR/../packages/cli/src/entry.ts"

if command -v bun >/dev/null 2>&1; then
  exec bun run "$ENTRY" "$@"
else
  echo "Error: Bun runtime is required to run fengagent." >&2
  echo "Install Bun: https://bun.sh/" >&2
  exit 1
fi
