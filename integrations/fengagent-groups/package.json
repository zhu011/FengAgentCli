{
  "name": "fengagent-groups",
  "version": "0.1.0",
  "private": true,
  "description": "DSH (DeepSeek Harness) plugin bridging FengAgentCli group chat into a DSH agent's toolset over the server HTTP API.",
  "type": "module",
  "main": "./src/plugin.mjs",
  "exports": {
    ".": "./src/plugin.mjs",
    "./tools": "./src/tools.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["src", "cordis.patch.yml", "README.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": { "node": ">=22" },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "license": "MIT"
}
